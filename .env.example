# Скопируй в .env.local и заполни. .env.local в git не попадает.

# Базовый URL сайта — canonical, sitemap.xml, Open Graph
NEXT_PUBLIC_SITE_URL=https://example.ru

# Только для сервера (docker-compose.yml): домены для Caddy через запятую.
# Пусто или «:80» — сайт по IP без HTTPS.
SITE_ADDRESS=example.ru, www.example.ru

# Telegram-уведомления о новых заявках (Агент 4, /api/leads)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Дублирование заявок на почту (опционально)
LEADS_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Аналитика (ТЗ п.7.6)
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=

# Яндекс.Карты (виджет контактов)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
